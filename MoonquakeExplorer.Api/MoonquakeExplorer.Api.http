@MoonquakeExplorer.Api_HostAddress = http://localhost:5235

GET {{MoonquakeExplorer.Api_HostAddress}}/api/weatherforecast
Accept: application/json

###

# Omit the year to receive dates for the current UTC year.
GET {{MoonquakeExplorer.Api_HostAddress}}/api/calendar/dates?year=2026
Accept: application/json

